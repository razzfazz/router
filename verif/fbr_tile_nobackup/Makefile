TOP = testbench

SRCS = $(TOP).v 

SRC_DIR = ../../src

#VCS_FLAGS = -y ~/Xilinx/src/unisims -y ~/Xilinx/src/simprims +incdir+~/Xilinx/src ~/Xilinx/src/glbl.v \+lint=all +v2k +libext+.v -timescale=1ns/1ns -Mupdate -debug -full64

VCS_FLAGS = \+lint=all +v2k +libext+.v -timescale=1ns/1ps -Mupdate -debug -full64 

PNR_VCS_FLAGS =  +v2k +libext+.v -timescale=1ns/1ns -Mupdate -debug -full64 -v /home/shared/system/cad/pdks/ST/cmos045-4.0/CMOS045_SC_14_CORE_LS_SNPS-AVT-CDS_3.0/behaviour/verilog/CMOS045_SC_14_CORE_LS.v -v /home/shared/system/cad/pdks/ST/cmos045-4.0/cva/st_memories/SPREG_090108-27570@1.0/behaviour/verilog/SPREG_090108.v -v /home/charting/cmos045-4.0/CMOS045_SC_14_CLK_LS_SNPS-AVT-CDS_4.0/behaviour/verilog/CMOS045_SC_14_CLK_LS.v +notimingcheck 

# DUMP_CTRL may be overidden by script calling this
DUMP_CTRL=
INT_CTRL=

# simv is generated by vcs
all: $(TOP)

$(TOP): $(SRCS) $(DUMP_CTRL) $(SRC_DIR)/*.v
	vcs -o $(TOP) $(VCS_FLAGS) $(INT_CTRL) -y $(SRC_DIR) -y . $(SRCS) $(DUMP_CTRL)

pnr: fbr_tile.v
	vcs -o $(TOP)_par $(PNR_VCS_FLAGS) $(INT_CTRL) -y $(SRC_DIR) -y . $(SRCS) $(DUMP_CTRL)

$(TOP)_fast: $(SRCS) $(DUMP_CTRL) $(SRC_DIR)/*.v
	vcs -o $(TOP)_fast +rad $(VCS_FLAGS) $(INT_CTRL) -y $(SRC_DIR) -y . $(SRCS) $(DUMP_CTRL)

clean:
	rm -rf work $(TOP) $(TOP)_fast $(TOP).daidir $(TOP)_fast.daidir transcript *.vcd *.vpd ucli.key vcs.key run.args csrc DVEfiles .vcsmx_rebuild *~ testbench_par $(TOP)_par.daidir
