gui_set_env TOGGLE::VALUEANNOTATE 0
gui_open_source -id ${Source.1}  -replace -active testbench /home/dub/router/trunk/verif/complex_alloc_vc/testbench.v
gui_src_set_reusable -id ${Source.1}

