gui_set_loading_session_type Restart
gui_set_env SIMSETUP::SIMARGS {{}}
gui_set_env SIMSETUP::SIMEXE {./simv}
gui_set_env SIMSETUP::ALLOW_POLL {0}
gui_clear_window -type Wave
gui_clear_window -type List

# Create and position top-level windows
set TopLevel.1 TopLevel.1

# Docked window settings
set HSPane.1 HSPane.1
set Hier.1 Hier.1
set Console.1 Console.1

# MDI window settings
set Source.1 Source.1
gui_update_layout -id ${Source.1} {{left -2} {top -15} {width 1083} {height 513} {show_state maximized} {dock_state undocked} {dock_on_new_line false}}
set DLPane.1 DLPane.1
set Data.1 Data.1
