TOP = testbench

SRCS = $(TOP).v 

SRC_DIR = ../../src

VCS_FLAGS = +lint=all +v2k +libext+.v -timescale=1ns/1ns -Mupdate -debug -full64

# DUMP_CTRL may be overidden by script calling this
DUMP_CTRL=
INT_CTRL=

# simv is generated by vcs
all: simv 

simv: $(SRCS) $(DUMP_CTRL) $(SRC_DIR)/*.v
	vcs $(VCS_FLAGS) $(INT_CTRL) -y $(SRC_DIR) -y . $(SRCS) $(DUMP_CTRL)

simvfast: $(SRCS) $(DUMP_CTRL) $(SRC_DIR)/*.v
	vcs -o simvfast +rad $(VCS_FLAGS) $(INT_CTRL) -y $(SRC_DIR) -y . $(SRCS) $(DUMP_CTRL)

clean:
	rm -rf work simv simv.daidir transcript *.vcd *.vpd vcs.key run.args csrc *~

realclean:	clean
	rm -rf my_sim.log PASS FAIL 
