TOP = testbench

SRCS = $(TOP).v 

SRC_DIR = ../../src

VCS_FLAGS = +lint=all +v2k +libext+.v -timescale=1ns/1ns -Mupdate -debug -full64

# DUMP_CTRL may be overidden by script calling this
DUMP_CTRL=
INT_CTRL=

# simv is generated by vcs
all: $(TOP)

$(TOP): $(SRCS) $(DUMP_CTRL) $(SRC_DIR)/*.v
	vcs -o $(TOP) $(VCS_FLAGS) $(INT_CTRL) -y $(SRC_DIR) -y . $(SRCS) $(DUMP_CTRL)

$(TOP)_fast: $(SRCS) $(DUMP_CTRL) $(SRC_DIR)/*.v
	vcs -o $(TOP)_fast +rad $(VCS_FLAGS) $(INT_CTRL) -y $(SRC_DIR) -y . $(SRCS) $(DUMP_CTRL)

clean:
	rm -rf work $(TOP) $(TOP)_fast $(TOP).daidir $(TOP)_fast.daidir transcript *.vcd *.vpd ucli.key vcs.key run.args csrc DVEfiles .vcsmx_rebuild *~
